# Dependencies (reinstall with: cd svelte && npm install)
node_modules/

# Vite cache
.vite/

# Documentation (not needed to run the site)
*.md
*.txt

# The rulebook in Markdown: the owner's copy of a copyrighted book, never versioned
/Mechatron-livre-md/

# Logo: the app's logo is versioned at svelte/src/assets/logo.png (inlined into the build).
# Other copies stay local: the v1 root assets/ folder and unused exports elsewhere.
/assets/
**/logo.png
!svelte/src/assets/logo.png

# Versioned snapshots of dist/index.html
svelte/releases/

# v1 legacy vanilla-JS sheet (kept locally in v1/, not versioned)
/v1/
/app.js
/data.js
/style.css
